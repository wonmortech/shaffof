{
	# Admin API only inside the container: deploy/receive.sh reloads config through it.
	admin localhost:2019
	auto_https off
}

:80 {
	# releases/current is a symlink swapped atomically by deploy/receive.sh.
	root * /srv/releases/current
	encode zstd gzip

	# File names are not content-hashed, so the browser revalidates everything (ETag, cheap 304s);
	# fonts never change under the same name.
	@fonts path /fonts/*
	header @fonts Cache-Control "public, max-age=2592000"
	@rest not path /fonts/*
	header @rest Cache-Control "no-cache"

	header {
		Content-Security-Policy "default-src 'self'; script-src 'self'; style-src 'self' 'sha256-RYwkQgHwALGx47zriHLE6GtlFqcVg4KJBFOFEuM4Vng='; img-src 'self' data:; font-src 'self'; connect-src 'self'; frame-ancestors 'none'; base-uri 'self'; form-action 'self'; object-src 'none'"
		Permissions-Policy "camera=(), microphone=(), geolocation=(), interest-cohort=()"
		Referrer-Policy strict-origin-when-cross-origin
		X-Content-Type-Options nosniff
		Cross-Origin-Opener-Policy same-origin
		-Server
	}

	file_server

	handle_errors 404 {
		rewrite * /404.html
		file_server
	}
}
