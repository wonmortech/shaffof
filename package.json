{
  "name": "shaffof-site",
  "version": "0.0.0",
  "private": true,
  "description": "Tests and linting for the Shaffof static site (no build step, no runtime dependencies).",
  "license": "Apache-2.0",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "test": "npm run test:unit && npm run test:coverage",
    "test:unit": "node --test --experimental-test-coverage --test-coverage-include=site/assets/js/merkle.js --test-coverage-include=site/assets/js/demo-core.js --test-coverage-lines=90 --test-coverage-branches=80 --test-coverage-functions=90 \"tests/unit/*.test.mjs\"",
    "test:e2e": "playwright test",
    "test:coverage": "node tools/coverage.mjs",
    "lint": "eslint . --max-warnings 0",
    "serve": "node tests/serve.mjs"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.65.0",
    "eslint": "10.14.0",
    "fast-check": "4.10.2",
    "globals": "17.14.0",
    "monocart-coverage-reports": "3.2.1"
  }
}
