{
  "name": "shaffof-site",
  "version": "0.0.0",
  "private": true,
  "description": "Tests for the Shaffof static site (no build step, no runtime dependencies).",
  "license": "Apache-2.0",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "test": "npm run test:unit && npm run test:e2e",
    "test:unit": "node --test --experimental-test-coverage --test-coverage-include=site/assets/js/merkle.js --test-coverage-include=site/assets/js/demo-core.js --test-coverage-lines=90 --test-coverage-branches=80 --test-coverage-functions=90 \"tests/unit/*.test.mjs\"",
    "test:e2e": "playwright test",
    "serve": "node tests/serve.mjs"
  },
  "devDependencies": {
    "@playwright/test": "1.64.1",
    "fast-check": "4.10.2"
  }
}
